let wiki_2 = {}
let wiki_2.index = 'Nguyen - index - 2015'
let wiki_2.path = '~/Dropbox/Papers/'
let wiki_2.path_html = '~/Dropbox/Papers/'
" let wiki_2.ext = '.wiki'
let wiki_2.auto_export = 0
let wiki_2.template_path = '~/Dropbox/wiki_assets/'
