nnoremap <leader>rr <cmd>lua require('user.plugins.git_review').reply()<CR>
nnoremap <leader>rt <cmd>lua require('user.plugins.git_review').top_comment()<CR>
nnoremap <leader>ra <cmd>lua require('user.plugins.git_review').ask()<CR>
nnoremap ]r <cmd>lua require('user.plugins.git_review').next_comment()<CR>
nnoremap [r <cmd>lua require('user.plugins.git_review').prev_comment()<CR>
nnoremap <leader>rf <cmd>lua require('user.plugins.git_review').list_file()<CR>
nnoremap <leader>R  <cmd>lua require('user.plugins.git_review').show_all()<CR>
nnoremap <leader>rl :call GitReviewList()<CR>
nnoremap <leader>rL :call GitReviewListAll()<CR>
nnoremap <leader>rx :call GitReviewClear()<CR>
nnoremap <leader>rX :call GitReviewClearAll()<CR>

