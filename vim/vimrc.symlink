" Use mouse in terminal vim
set mouse=a

" --- git review: line-level comments via git notes ---
" Adapted from jaykar's review system
sign define ReviewComment text=> texthl=WarningMsg
set signcolumn=auto

function! GitReviewRoot()
  let l:root = substitute(system('git rev-parse --show-toplevel 2>/dev/null'), '\n$', '', '')
  if !v:shell_error && !empty(l:root)
    return l:root
  endif
  return ''
endfunction

function! GitReviewFileFromBuffer()
  " Extract the real relative file path, handling Diffview and Fugitive buffers
  let l:root = GitReviewRoot()
  let l:bufname = expand('%:p')

  " Diffview buffers:
  "   Regular repo: diffview:///path/to/repo/.git/<ref>//path/to/file
  "   Worktree:     diffview:///path/.git/worktrees/<name>/<sha>/path/to/file
  if l:bufname =~# '^diffview://'
    " Try double-slash pattern first (regular repo)
    if l:bufname =~# '\.git/[^/]*//'
      return substitute(l:bufname, '.*\.git/[^/]*//', '', '')
    endif
    " Worktree pattern: .git/worktrees/<name>/<hex-sha>/
    if l:bufname =~# '\.git/worktrees/[^/]\+/[0-9a-f]\+/'
      return substitute(l:bufname, '.*\.git/worktrees/[^/]\+/[0-9a-f]\+/', '', '')
    endif
    " Fallback: strip everything up to last .git/.../ sequence
    return substitute(l:bufname, '.*\.git/.\{-\}/', '', '')
  endif

  " Fugitive buffers: fugitive:///path/to/repo/.git//path/to/file
  if l:bufname =~# '^fugitive://'
    let l:after_git = substitute(l:bufname, '.*\.git//\?', '', '')
    return l:after_git
  endif

  " Normal buffer: strip git root prefix
  if !empty(l:root) && l:bufname[:len(l:root)-1] ==# l:root
    return l:bufname[len(l:root)+1:]
  endif

  return expand('%:.')
endfunction

function! GitReviewComment()
  let l:root = GitReviewRoot()
  if empty(l:root)
    echo "Not in a git repo"
    return
  endif
  let l:relfile = GitReviewFileFromBuffer()
  if empty(l:relfile)
    echo "Cannot determine file path"
    return
  endif
  let l:line = line('.')
  " Detect left (base) vs right (new) side in diff mode
  let l:side = ''
  if &diff
    let l:winnr = winnr()
    let l:total = winnr('$')
    let l:side = (l:winnr <= l:total / 2) ? '< ' : '> '
  endif
  let l:msg = input('Comment (' . l:relfile . ':' . l:line . '): ')
  if empty(l:msg)
    return
  endif
  let l:msg = l:side . l:msg
  call system('git -C ' . shellescape(l:root) . ' review comment -f ' . shellescape(l:relfile) . ' -l ' . l:line . ' -m ' . shellescape(l:msg))
  echo " Added."
  call GitReviewPlaceSigns()
endfunction

function! GitReviewList()
  let l:root = GitReviewRoot()
  if empty(l:root)
    echo "Not in a git repo"
    return
  endif
  let l:raw = systemlist('git -C ' . shellescape(l:root) . ' review list HEAD')
  " Parse into quickfix entries
  let l:qf = []
  for line in l:raw
    let l:m = matchlist(line, '^\(.\{-}\):\(\d\+\):\s*\(.*\)')
    if !empty(l:m)
      call add(l:qf, {'filename': l:root . '/' . l:m[1], 'lnum': l:m[2], 'text': l:m[3]})
    endif
  endfor
  if empty(l:qf)
    echo "No review comments."
  else
    call setqflist(l:qf)
    copen
  endif
endfunction

function! GitReviewPlaceSigns()
  " Clear previous review signs for this buffer only
  for id in range(9000, 9200)
    silent! execute 'sign unplace ' . id . ' buffer=' . bufnr('%')
  endfor
  let l:root = GitReviewRoot()
  if empty(l:root)
    return
  endif
  let l:relfile = GitReviewFileFromBuffer()
  if empty(l:relfile)
    return
  endif
  let l:raw = systemlist('git -C ' . shellescape(l:root) . ' review list HEAD')
  let l:fpat = escape(l:relfile, '.')
  let l:id = 9000
  for c in l:raw
    if c =~# '^' . l:fpat . ':\d\+:'
      let l:m = matchlist(c, l:fpat . ':\(\d\+\):')
      if !empty(l:m)
        execute 'sign place ' . l:id . ' line=' . l:m[1] . ' name=ReviewComment buffer=' . bufnr('%')
        let l:id += 1
      endif
    endif
  endfor
endfunction

function! GitReviewGetComment()
  " Return the comment text at the current file:line, or empty string
  let l:root = GitReviewRoot()
  if empty(l:root)
    return ''
  endif
  let l:relfile = GitReviewFileFromBuffer()
  let l:line = line('.')
  let l:raw = systemlist('git -C ' . shellescape(l:root) . ' review list HEAD')
  let l:pattern = '^' . escape(l:relfile, '.') . ':' . l:line . ':\s*'
  for c in l:raw
    if c =~# l:pattern
      return substitute(c, l:pattern, '', '')
    endif
  endfor
  return ''
endfunction

function! GitReviewShow()
  let l:comment = GitReviewGetComment()
  if empty(l:comment)
    echo "No comment on this line."
  else
    echo "Review: " . l:comment
  endif
endfunction

function! GitReviewEdit()
  let l:root = GitReviewRoot()
  if empty(l:root)
    echo "Not in a git repo"
    return
  endif
  let l:relfile = GitReviewFileFromBuffer()
  if empty(l:relfile)
    echo "Cannot determine file path"
    return
  endif
  let l:line = line('.')
  let l:existing = GitReviewGetComment()
  if empty(l:existing)
    echo "No comment on this line. Use ,rc to add one."
    return
  endif
  " Prompt with existing comment pre-populated
  let l:new = input('Edit (empty to delete): ', l:existing)
  " Read raw notes, find and replace/remove the matching line
  let l:sha = trim(system('git -C ' . shellescape(l:root) . ' rev-parse HEAD'))
  let l:notes = systemlist('git -C ' . shellescape(l:root) . ' notes --ref=refs/notes/reviews show ' . l:sha)
  let l:pattern = '^' . escape(l:relfile, '.') . ':' . l:line . ':'
  let l:updated = []
  for n in l:notes
    if n =~# l:pattern
      if !empty(l:new)
        call add(l:updated, l:relfile . ':' . l:line . ': ' . l:new)
      endif
      " else: skip the line (delete)
    else
      call add(l:updated, n)
    endif
  endfor
  if empty(l:updated)
    call system('git -C ' . shellescape(l:root) . ' notes --ref=refs/notes/reviews remove ' . l:sha . ' 2>/dev/null')
  else
    call system('git -C ' . shellescape(l:root) . ' notes --ref=refs/notes/reviews add -f -m ' . shellescape(join(l:updated, "\n")) . ' ' . l:sha)
  endif
  echo empty(l:new) ? " Deleted." : " Updated."
  call GitReviewPlaceSigns()
endfunction

function! GitReviewClear()
  let l:root = GitReviewRoot()
  if empty(l:root)
    echo "Not in a git repo"
    return
  endif
  call system('git -C ' . shellescape(l:root) . ' review clear HEAD')
  echo "Review comments cleared."
  call GitReviewPlaceSigns()
endfunction

function! GitReviewListAll()
  let l:root = GitReviewRoot()
  if empty(l:root)
    echo "Not in a git repo"
    return
  endif
  let l:raw = systemlist('git -C ' . shellescape(l:root) . ' review list --all HEAD')
  let l:qf = []
  for line in l:raw
    let l:m = matchlist(line, '^\(.\{-}\):\(\d\+\):\s*\(.*\)')
    if !empty(l:m)
      call add(l:qf, {'filename': l:root . '/' . l:m[1], 'lnum': l:m[2], 'text': l:m[3]})
    endif
  endfor
  if empty(l:qf)
    echo "No review comments on branch."
  else
    call setqflist(l:qf)
    copen
  endif
endfunction

function! GitReviewClearAll()
  let l:root = GitReviewRoot()
  if empty(l:root)
    echo "Not in a git repo"
    return
  endif
  let l:confirm = input('Clear ALL review comments on this branch? (y/N): ')
  if l:confirm !=# 'y'
    echo " Cancelled."
    return
  endif
  call system('git -C ' . shellescape(l:root) . ' review clear --all HEAD')
  echo " All branch review comments cleared."
  call GitReviewPlaceSigns()
endfunction

nnoremap <leader>r  <cmd>lua require('user.plugins.git_review').show()<CR>
nnoremap <leader>rs <cmd>lua require('user.plugins.git_review').show_scroll()<CR>
nnoremap <leader>rc <cmd>lua require('user.plugins.git_review').comment()<CR>
nnoremap <leader>re <cmd>lua require('user.plugins.git_review').edit()<CR>
